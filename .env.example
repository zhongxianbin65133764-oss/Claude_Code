# ============================================
# Polymarket Resolution-Time Arbitrage Bot
# Copy this to .env and fill in your values.
# NEVER commit .env to git.
# ============================================

# ---- Runtime mode ----
# DRY_RUN=true  -> No real orders, just log opportunities
# DRY_RUN=false -> LIVE trading with real USDC
DRY_RUN=true

# ---- Polymarket API credentials (only required when DRY_RUN=false) ----
# Get these by signing up at https://polymarket.com and creating an API key
# in your account settings. The bot will derive your funder address from the
# private key.
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# ---- Polygon wallet ----
# Private key of the EOA that holds USDC and will sign orders.
# CRITICAL: use a dedicated bot wallet, NEVER your main wallet.
# Keep no more than your max-exposure budget on this wallet.
WALLET_PRIVATE_KEY=

# Polygon RPC (default works but rate-limited; consider Alchemy/Infura)
POLYGON_RPC_URL=https://polygon-rpc.com

# ---- Optional: Telegram alerts ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================
# Realism layer (only used in DRY_RUN mode)
# These narrow the gap between dry-run and live trading.
# Defaults are conservative; tune with empirical data after a week.
# ============================================

# Re-check the orderbook this many seconds after detecting an opportunity,
# simulating the latency from detection -> signing -> CLOB matching.
VERIFICATION_DELAY_SECONDS=60

# Per-trade gas + signing overhead in USDC.
ESTIMATED_GAS_COST_USD=0.10

# Average fraction of intended size that actually fills.
EXPECTED_FILL_RATIO=0.70

# Probability a fill is "adverse" (seller knew something we didn't) -> goes to $0.
ADVERSE_FILL_RATE=0.03

# Probability of UMA dispute reversing the outcome.
UMA_DISPUTE_RATE=0.02

# ============================================
# S-tier optimizations (used in both dry-run and live)
# ============================================

# Strict subcategory whitelist: only crypto_price + team_moneyline
# markets that match high-confidence regex patterns. Cuts UMA dispute
# rate by an estimated 5-10x at the cost of fewer opportunities.
USE_SUBCATEGORY_FILTER=true

# Independently verify crypto markets against Coinbase before trading.
# When the oracle says one side wins, we only trade that side, and
# we pay up to ORACLE_VERIFIED_MAX_BUY_PRICE instead of MAX_BUY_PRICE.
USE_ORACLE=true
ORACLE_VERIFIED_MAX_BUY_PRICE=0.985

# Skip markets below this lifetime volume. Polymarket's API is dominated
# by long-tail $0-volume "exact score" / niche prop markets that we
# never want. $500 cuts out 80%+ of the junk.
MIN_MARKET_VOLUME_USD=500

# ============================================
# Adaptive scan interval (optional)
# Scan aggressively during high-activity UTC windows, lazily otherwise.
# Saves network + gas during dead periods.
# Defaults below cover crypto daily-close (UTC 0-2) + US sports
# primetime (UTC 18-23).
# ============================================
ADAPTIVE_SCAN_ENABLED=false
HIGH_ACTIVITY_HOURS_UTC=0,1,2,18,19,20,21,22,23
HIGH_ACTIVITY_INTERVAL_SECONDS=30
LOW_ACTIVITY_INTERVAL_SECONDS=300
